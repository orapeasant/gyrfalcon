{
  "name": "gyrfalcon-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:aie": "tsc --project ../apps/aie/web/tsconfig.json && GYRFALCON_APP_KEY=aie vite build",
    "build:wf": "tsc --project ../apps/wf/web/tsconfig.json && GYRFALCON_APP_KEY=wf vite build",
    "build:fnd": "tsc --project ../apps/fnd/web/tsconfig.json && GYRFALCON_APP_KEY=fnd vite build",
    "build:apps": "npm run build:aie && npm run build:wf && npm run build:fnd",
    "preview": "vite preview",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
